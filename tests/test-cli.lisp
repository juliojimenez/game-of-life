;;;; tests/test-cli.lisp — tests for src/cli.lisp: arguments, main, summaries (DESIGN.md §5.9).

(in-package :game-of-life-test)

(defun %main (&rest args)
  "Run MAIN on ARGS with both output streams captured; return (values code stdout stderr)."
  (with-captured-output (out err) (main args)))

(defun %trimmed (string)
  "STRING without trailing newlines."
  (string-right-trim '(#\Newline #\Return) string))

(deftest cli/help-version-list
  (multiple-value-bind (code out err) (%main "--help")
    (is-equal 0 code)
    (is (search "Usage:" out))
    (is (search "--headless" out))
    (is-equal "" err)
    (dolist (option '("-r, --rule" "-t, --topology" "-W, --width" "-H, --height" "-d, --density"
                      "-s, --seed" "-g, --generations" "-f, --fps" "--ascii" "--dots" "--follow"
                      "--stop-when-stable" "--write" "-l, --list" "--show" "-h, --help"
                      "--version"))
      (is (search option out) "the help text mentions ~A" option)))
  (multiple-value-bind (code out) (%main "-h")
    (is-equal 0 code)
    (is (search "Usage:" out)))
  (multiple-value-bind (code out err) (%main "--version")
    (is-equal 0 code)
    (is (search "life 0.1.0" out))
    (is-equal "0.1.0" *version*)
    (is-equal "" err))
  (dolist (flag '("--list" "-l"))
    (multiple-value-bind (code out err) (%main flag)
      (is-equal 0 code)
      (is (search "glider" out) "~A lists the glider" flag)
      (is (search "gosper-glider-gun" out) "~A lists the gun" flag)
      (is (search "spaceship" out))
      (is-equal "" err)))
  ;; the usage function writes the same text where asked
  (let ((text (with-output-to-string (s) (usage s))))
    (is (search "Usage:" text))
    (is (search "--headless" text)))
  (multiple-value-bind (value out) (with-captured-output (o e) (usage))
    (declare (ignore value))
    (is (search "Usage:" out))))

(deftest cli/show
  (multiple-value-bind (code out err) (%main "--show" "glider")
    (is-equal 0 code)
    (is-equal "" err)
    (is (search "Glider (spaceship, period 4, 5 cells)" out))
    (is (search (format nil ".O.~%..O~%OOO~%") out))
    (is-equal (format nil "Glider (spaceship, period 4, 5 cells)~%.O.~%..O~%OOO~%") out))
  (multiple-value-bind (code out) (%main "--show=acorn")
    (is-equal 0 code)
    (is (%starts-with-p (format nil "Acorn (methuselah, 7 cells)~%") out) "got ~S" out))
  (multiple-value-bind (code out) (%main "--show" "block")
    (is-equal 0 code)
    (is (%starts-with-p "Block (still life" out) "got ~S" out)
    (is (search "4 cells)" out))
    (is (search (format nil "OO~%OO~%") out)))
  (multiple-value-bind (code out) (%main "--show" "Gosper glider gun")
    (is-equal 0 code)
    (is (%starts-with-p (format nil "Gosper glider gun (gun, period 30, 36 cells)~%") out)
        "got ~S" out)
    (is-equal 10 (count #\Newline out)))
  ;; a file pattern: Name (M cells)
  (let ((f (temp-file "shown.cells")))
    (write-pattern-file (make-pattern *glider-cells*) f :format :plaintext)
    (multiple-value-bind (code out) (%main "--show" (namestring f))
      (is-equal 0 code)
      (is-equal (format nil "shown (5 cells)~%.O.~%..O~%OOO~%") out)))
  (multiple-value-bind (code out err) (%main "--show" "nosuch")
    (declare (ignore out))
    (is-equal 1 code)
    (is (search "--list" err))))

(deftest cli/usage-errors
  (dolist (args '(("--bogus") ("-W" "abc") ("-W" "0") ("-d" "2") ("-f" "0") ("glider" "block")
                  ("-t" "sphere") ("-g") ("-g" "abc") ("-W") ("--width=") ("-d" "1.5") ("-s" "x")
                  ("-g" "-1") ("-x") ("--rule") ("--fps=-1") ("-H" "1.5")))
    (multiple-value-bind (code out err) (apply #'%main args)
      (is (eql 2 code) "~S exits 2 (got ~S)" args code)
      (is (search "Try 'life --help'" err) "~S tells about --help: ~S" args err)
      (is-equal "" out))))

(deftest cli/unknown-pattern
  (multiple-value-bind (code out err) (%main "nosuchpattern" "--headless" "-g" "1")
    (is-equal 1 code)
    (is-equal "" out)
    (is (search "--list" err))
    (is (search "nosuchpattern" err))
    (is (%starts-with-p "life: " err) "the message is prefixed: ~S" err))
  (multiple-value-bind (code out err) (%main "./no/such/file.rle" "--headless")
    (declare (ignore out))
    (is-equal 1 code)
    (is (search "life: " err))))

(deftest cli/headless-facts
  (loop for (args expected)
          in (list (list '("r-pentomino" "--headless" "-g" "1103")
                         "R-pentomino: generation 1103, population 116")
                   (list '("diehard" "--headless") "Diehard: extinct at generation 130")
                   (list '("blinker" "--headless")
                         "Blinker: period 2 detected at generation 2, population 3")
                   (list '("glider" "--headless" "-g" "8") "Glider: generation 8, population 5")
                   (list '("block" "--headless")
                         "Block: period 1 detected at generation 1, population 4")
                   (list '("glider" "--headless" "--generations=0")
                         "Glider: generation 0, population 5")
                   (list '("--headless" "-g" "4" "glider") "Glider: generation 4, population 5")
                   (list '("pentadecathlon" "--headless")
                         "Pentadecathlon: period 15 detected at generation 15, population 12")
                   (list '("Gosper glider gun" "--headless" "-g" "30")
                         "Gosper glider gun: generation 30, population 41")
                   (list '("lwss" "--headless" "-g" "4")
                         "Lightweight spaceship: generation 4, population 9"))
        do (multiple-value-bind (code out err) (apply #'%main args)
             (is (eql 0 code) "~S exits 0 (got ~S)" args code)
             (is (string= "" err) "~S writes nothing to stderr: ~S" args err)
             (is (string= expected (%trimmed out)) "~S prints ~S, got ~S" args expected out))))

(deftest cli/headless-soup
  (let ((args '("--headless" "-g" "5" "-s" "7" "-W" "20" "-H" "10")))
    (multiple-value-bind (code out err) (apply #'%main args)
      (is-equal 0 code)
      (is-equal "" err)
      (is (%starts-with-p "soup 20x10 density 0.30 seed 7:" out) "got ~S" out)
      (is-equal 1 (count #\Newline out))
      (multiple-value-bind (code2 out2) (apply #'%main args)
        (is-equal 0 code2)
        (is-equal out out2))))
  (multiple-value-bind (code out)
      (%main "--headless" "-g" "5" "-s" "7" "-W" "20" "-H" "10" "-d" "0")
    (is-equal 0 code)
    (is-equal "soup 20x10 density 0.00 seed 7: extinct at generation 0" (%trimmed out)))
  ;; random and soup name the soup
  (dolist (word '("random" "soup"))
    (multiple-value-bind (code out)
        (%main word "--headless" "-g" "1" "-s" "7" "-W" "20" "-H" "10")
      (is-equal 0 code)
      (is (%starts-with-p "soup 20x10 density 0.30 seed 7:" out)
          "~A gives a soup: ~S" word out)))
  ;; a full soup on a tiny torus has width*height cells; density prints with two decimals
  (multiple-value-bind (code out) (%main "--headless" "-g" "0" "-d" "1" "-W" "4" "-H" "3" "-s" "1")
    (is-equal 0 code)
    (is-equal "soup 4x3 density 1.00 seed 1: generation 0, population 12" (%trimmed out)))
  (multiple-value-bind (code out)
      (%main "--headless" "-g" "0" "-d" "0.5" "-W" "4" "-H" "3" "-s" "1")
    (is-equal 0 code)
    (is (%starts-with-p "soup 4x3 density 0.50 seed 1: generation 0, population " out)
        "got ~S" out))
  ;; a different seed gives a different soup (population or outcome)
  (multiple-value-bind (code out) (%main "--headless" "-g" "0" "-s" "8" "-W" "20" "-H" "10")
    (is-equal 0 code)
    (is (%starts-with-p "soup 20x10 density 0.30 seed 8:" out)))
  ;; the plane soup fills the default viewport's rectangle
  (multiple-value-bind (code out)
      (%main "--headless" "-t" "plane" "-W" "10" "-H" "10" "-s" "1" "-g" "0")
    (is-equal 0 code)
    (is (%starts-with-p "soup 10x10 density 0.30 seed 1: generation 0, population " out)
        "got ~S" out)))

(deftest cli/rule-and-topology
  (multiple-value-bind (code out err) (%main "blinker" "--headless" "-r" "seeds")
    (is-equal 0 code)
    (is-equal "" err)
    (is-equal "Blinker: extinct at generation 5" (%trimmed out)))
  (multiple-value-bind (code out) (%main "blinker" "--headless" "--rule=B2/S")
    (is-equal 0 code)
    (is-equal "Blinker: extinct at generation 5" (%trimmed out)))
  (multiple-value-bind (code out)
      (%main "glider" "--headless" "-t" "torus" "-W" "8" "-H" "8" "-g" "40")
    (is-equal 0 code)
    (is (search "period 32 detected at generation 32" out) "got ~S" out)
    (is-equal "Glider: period 32 detected at generation 32, population 5" (%trimmed out)))
  (multiple-value-bind (code out)
      (%main "glider" "--headless" "--topology=torus" "--width=8" "--height=8" "-g" "20")
    (is-equal 0 code)
    (is-equal "Glider: generation 20, population 5" (%trimmed out)))
  (multiple-value-bind (code out err) (%main "glider" "--headless" "--rule" "B9" "-g" "1")
    (declare (ignore out))
    (is-equal 1 code)
    (is (%starts-with-p "life: " err) "got ~S" err)
    (is (search "B9" err) "the message quotes the rule"))
  (multiple-value-bind (code out err) (%main "--headless" "-r" "nosuchrule" "-g" "1")
    (declare (ignore out))
    (is-equal 1 code)
    (is (search "nosuchrule" err)))
  ;; a box: the glider hits the corner and becomes a block
  (multiple-value-bind (code out) (%main "glider" "--headless" "-t" "box" "-W" "8" "-H" "8")
    (is-equal 0 code)
    (is-equal "Glider: period 1 detected at generation 16, population 4" (%trimmed out)))
  ;; a pattern that does not fit the torus
  (multiple-value-bind (code out err)
      (%main "gosper-glider-gun" "--headless" "-t" "torus" "-W" "20" "-H" "10")
    (declare (ignore out))
    (is-equal 1 code)
    (is (search "does not fit" err) "got ~S" err)
    (is (search "36x9" err))
    (is (search "20x10 torus" err)))
  ;; HighLife keeps a blinker a blinker; the headless default limit is 1000
  (multiple-value-bind (code out) (%main "blinker" "--headless" "-r" "highlife")
    (is-equal 0 code)
    (is-equal "Blinker: period 2 detected at generation 2, population 3" (%trimmed out)))
  (multiple-value-bind (code out) (%main "glider" "--headless")
    (is-equal 0 code)
    (is-equal "Glider: generation 1000, population 5" (%trimmed out)))
  ;; --stop-when-stable without --headless is a usage of run; headless already implies it
  (multiple-value-bind (code out) (%main "block" "--headless" "--stop-when-stable")
    (is-equal 0 code)
    (is-equal "Block: period 1 detected at generation 1, population 4" (%trimmed out))))

(deftest cli/write
  (let ((f (temp-file "x.rle")))
    (multiple-value-bind (code out err)
        (%main "glider" "--headless" "-g" "4" "--write" (namestring f))
      (is-equal 0 code)
      (is-equal "" err)
      (is-equal "Glider: generation 4, population 5" (%trimmed out)))
    (is (probe-file f))
    (let ((p (read-pattern-file f)))
      (is (pattern-equal (pattern "glider") p))
      (is-equal "Glider" (pattern-name p))
      (is-equal "B3/S23" (rule-string (pattern-rule p))))
    (is (%starts-with-p "#N Glider" (uiop:read-file-string f))))
  ;; an empty world writes the empty pattern
  (let ((f (temp-file "empty.rle")))
    (multiple-value-bind (code out) (%main "diehard" "--headless" "--write" (namestring f))
      (is-equal 0 code)
      (is-equal "Diehard: extinct at generation 130" (%trimmed out)))
    (is-equal 0 (pattern-population (read-pattern-file f)))
    (is (search (format nil "x = 0, y = 0, rule = B3/S23~%!") (uiop:read-file-string f))))
  ;; --write=FILE keeps the rule in effect
  (let ((f (temp-file "hl.rle")))
    (multiple-value-bind (code) (%main "blinker" "--headless" "-r" "highlife" "-g" "1"
                                       (format nil "--write=~A" (namestring f)))
      (is-equal 0 code))
    (let ((p (read-pattern-file f)))
      (is-equal "B36/S23" (rule-string (pattern-rule p)))
      (is-equal "Blinker" (pattern-name p))
      (is-equal '((0 . 0) (0 . 1) (0 . 2)) (pattern-cells p))))
  ;; a soup is written too, and reads back with the same population
  (let ((f (temp-file "soup.rle")))
    (multiple-value-bind (code out)
        (%main "--headless" "-g" "0" "-s" "3" "-W" "12" "-H" "6" "--write" (namestring f))
      (is-equal 0 code)
      (let* ((text (%trimmed out))
             (start (search "population " text))
             (n (parse-integer text :start (+ start (length "population ")))))
        (is-equal n (pattern-population (read-pattern-file f)))))))

(deftest cli/parse-arguments
  (let ((p (parse-arguments '("--generations=100" "glider"))))
    (is-equal 100 (getf p :generations))
    (is-equal "glider" (getf p :pattern)))
  (let ((p (parse-arguments '("-g" "100" "glider"))))
    (is-equal 100 (getf p :generations))
    (is-equal "glider" (getf p :pattern)))
  (let ((p (parse-arguments '("glider" "-g" "100"))))
    (is-equal 100 (getf p :generations))
    (is-equal "glider" (getf p :pattern)))
  (let ((p (parse-arguments '("--" "-weird"))))
    (is-equal "-weird" (getf p :pattern)))
  (let ((p (parse-arguments '("-g" "3" "--" "--help"))))
    (is-equal "--help" (getf p :pattern))
    (is-equal 3 (getf p :generations))
    (is-equal nil (getf p :help)))
  (is-equal nil (getf (parse-arguments '("random")) :pattern))
  (is-equal nil (getf (parse-arguments '("soup")) :pattern))
  (is-equal nil (getf (parse-arguments '()) :pattern))
  (is-equal nil (getf (parse-arguments '()) :headless))
  (is-equal nil (getf (parse-arguments '("glider")) :generations))
  (let ((p (parse-arguments '("--rule=B36/S23" "-t" "box" "-W" "30" "-H" "20" "-d" "0.5" "-s" "9"
                              "-f" "2.5" "--ascii" "--follow" "--stop-when-stable" "--headless"
                              "--write" "out.rle"))))
    (is-equal "B36/S23" (getf p :rule))
    (is-equal :box (getf p :topology))
    (is-equal 30 (getf p :width))
    (is-equal 20 (getf p :height))
    (is (= 1/2 (getf p :density)))
    (is (typep (getf p :density) 'double-float))
    (is-equal 9 (getf p :seed))
    (is (= 5/2 (getf p :fps)))
    (is (typep (getf p :fps) 'double-float))
    (is-equal :ascii (getf p :style))
    (is-equal t (getf p :follow))
    (is-equal t (getf p :stop-when-stable))
    (is-equal t (getf p :headless))
    (is-equal "out.rle" (getf p :write))
    (is-equal nil (getf p :pattern))
    (is-equal nil (getf p :list))
    (is-equal nil (getf p :show)))
  (let ((p (parse-arguments '("--dots" "--topology=torus" "--width=10" "--height=5" "--density=1"
                              "--seed=-3" "--fps=60" "--show" "glider" "--list" "--help"
                              "--version"))))
    (is-equal :dots (getf p :style))
    (is-equal :torus (getf p :topology))
    (is-equal 10 (getf p :width))
    (is-equal 5 (getf p :height))
    (is (= 1 (getf p :density)))
    (is (integerp (getf p :density)))
    (is-equal -3 (getf p :seed))
    (is (= 60 (getf p :fps)))
    (is (integerp (getf p :fps)))
    (is-equal "glider" (getf p :show))
    (is-equal t (getf p :list))
    (is-equal t (getf p :help))
    (is-equal t (getf p :version)))
  (is-equal t (getf (parse-arguments '("-l")) :list))
  (is-equal t (getf (parse-arguments '("-h")) :help))
  (is-equal :plane (getf (parse-arguments '("-t" "plane")) :topology))
  (is-equal "seeds" (getf (parse-arguments '("-r" "seeds")) :rule))
  (is-equal 0 (getf (parse-arguments '("-g" "0")) :generations))
  (is-equal 7 (getf (parse-arguments '("-s" "+7")) :seed))
  (is-equal "./my glider.rle" (getf (parse-arguments '("./my glider.rle")) :pattern))
  (is-equal "glider" (getf (parse-arguments '("--show=glider")) :show))
  ;; the last of a repeated option wins
  (is-equal 5 (getf (parse-arguments '("-g" "3" "-g" "5")) :generations))
  (signals usage-error (parse-arguments '("--bogus")))
  (signals usage-error (parse-arguments '("glider" "block")))
  (signals usage-error (parse-arguments '("-W" "abc")))
  (signals usage-error (parse-arguments '("-W" "0")))
  (signals usage-error (parse-arguments '("-f" "0")))
  (signals usage-error (parse-arguments '("-d" "1.5")))
  (signals usage-error (parse-arguments '("-d" "-0.5")))
  (signals usage-error (parse-arguments '("-t" "sphere")))
  (signals usage-error (parse-arguments '("-g")))
  (signals usage-error (parse-arguments '("-g" "-1")))
  (signals usage-error (parse-arguments '("-g" "1.5")))
  (signals usage-error (parse-arguments '("--write")))
  (signals usage-error (parse-arguments '("-W" "1e3")))
  (let ((e (handler-case (progn (parse-arguments '("--bogus")) nil)
             (usage-error (c) c))))
    (is (typep e 'life-error))
    (is (search "--bogus" (princ-to-string e)) "the report names the option")))

(deftest cli/file-pattern
  (let ((f (temp-file "my-glider.cells")))
    (with-open-file (s f :direction :output :if-exists :supersede)
      (format s ".O.~%..O~%OOO~%"))
    (multiple-value-bind (code out err) (%main (namestring f) "--headless" "-g" "4")
      (is-equal 0 code)
      (is-equal "" err)
      (is (search "population 5" out))
      (is-equal "my-glider: generation 4, population 5" (%trimmed out))))
  ;; a file with its own rule uses it unless --rule is given
  (let ((f (temp-file "seeds-blinker.rle")))
    (with-open-file (s f :direction :output :if-exists :supersede)
      (format s "x = 3, y = 1, rule = B2/S~%3o!~%"))
    (multiple-value-bind (code out) (%main (namestring f) "--headless")
      (is-equal 0 code)
      (is-equal "seeds-blinker: extinct at generation 5" (%trimmed out)))
    (multiple-value-bind (code out) (%main (namestring f) "--headless" "-r" "life")
      (is-equal 0 code)
      (is-equal "seeds-blinker: period 2 detected at generation 2, population 3" (%trimmed out))))
  ;; a named file reports its #N name; a Life 1.06 file works too
  (let ((f (temp-file "anything.rle")))
    (write-pattern-file (pattern "glider") f)
    (multiple-value-bind (code out) (%main (namestring f) "--headless" "-g" "4")
      (is-equal 0 code)
      (is-equal "Glider: generation 4, population 5" (%trimmed out))))
  (let ((f (temp-file "g.lif")))
    (with-open-file (s f :direction :output :if-exists :supersede)
      (format s "#Life 1.06~%1 0~%2 1~%0 2~%1 2~%2 2~%"))
    (multiple-value-bind (code out) (%main (namestring f) "--headless" "-g" "4")
      (is-equal 0 code)
      (is-equal "g: generation 4, population 5" (%trimmed out))))
  ;; a file pattern on a torus
  (let ((f (temp-file "t.cells")))
    (with-open-file (s f :direction :output :if-exists :supersede)
      (format s "!Name: Torus glider~%.O.~%..O~%OOO~%"))
    (multiple-value-bind (code out)
        (%main (namestring f) "--headless" "-t" "torus" "-W" "8" "-H" "8")
      (is-equal 0 code)
      (is-equal "Torus glider: period 32 detected at generation 32, population 5"
                (%trimmed out))))
  ;; a broken file is a life-error, exit 1
  (let ((f (temp-file "bad.rle")))
    (with-open-file (s f :direction :output :if-exists :supersede)
      (format s "x = 3, y = 3~%bo$2bo$3%!~%"))
    (multiple-value-bind (code out err) (%main (namestring f) "--headless")
      (declare (ignore out))
      (is-equal 1 code)
      (is (%starts-with-p "life: " err) "got ~S" err))))
