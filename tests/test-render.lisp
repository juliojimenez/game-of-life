;;;; tests/test-render.lisp — tests for src/render.lisp: viewports, frames, status line, draw
;;;; (DESIGN.md §5.6).

(in-package :game-of-life-test)

(defparameter *full-block* (string (code-char #x2588)) "U+2588 FULL BLOCK as a string.")
(defparameter *upper-half* (string (code-char #x2580)) "U+2580 UPPER HALF BLOCK as a string.")
(defparameter *lower-half* (string (code-char #x2584)) "U+2584 LOWER HALF BLOCK as a string.")

(defun %blinker-box ()
  "A 3x3 box world with a horizontal blinker in row 1."
  (let ((w (make-world :topology :box :width 3 :height 3)))
    (place w "blinker" :x 0 :y 1)
    w))

(defun %vertical-blinker-box ()
  "A 3x3 box world with a vertical blinker in column 1."
  (let ((w (make-world :topology :box :width 3 :height 3)))
    (dotimes (y 3) (setf (alive-p w 1 y) t))
    w))

(defun %viewport-3x3 ()
  "The viewport covering a 3x3 box world."
  (make-viewport :x 0 :y 0 :width 3 :height 3))

(deftest render/blinker-dots
  (let ((w (%blinker-box)))
    (is-equal (format nil "...~%OOO~%...") (render-frame w (%viewport-3x3) :style :dots))
    (is-equal (format nil "...~%OOO~%...") (render-frame w (default-viewport w 80 24) :style :dots))
    (is-equal (format nil ".O.~%.O.~%.O.") (render-frame (%vertical-blinker-box) (%viewport-3x3)
                                                        :style :dots))
    ;; the frame has no trailing newline and exactly width characters per line
    (let ((frame (render-frame w (%viewport-3x3) :style :dots)))
      (is-equal 11 (length frame))
      (is (every (lambda (line) (= 3 (length line))) (%split-lines frame))))))

(deftest render/blinker-ascii
  (is-equal (format nil "   ~%###~%   ")
            (render-frame (%blinker-box) (%viewport-3x3) :style :ascii))
  (is-equal (format nil " # ~% # ~% # ")
            (render-frame (%vertical-blinker-box) (%viewport-3x3) :style :ascii))
  (is-equal (format nil "   ~%   ~%   ")
            (render-frame (make-world :topology :box :width 3 :height 3) (%viewport-3x3)
                          :style :ascii)))

(deftest render/blinker-blocks
  (let ((vp (%viewport-3x3)))
    (is-equal (format nil "~A~A~A~%   " *lower-half* *lower-half* *lower-half*)
              (render-frame (%blinker-box) vp))
    (is-equal (format nil "~A~A~A~%   " *lower-half* *lower-half* *lower-half*)
              (render-frame (%blinker-box) vp :style :blocks))
    (is-equal (format nil " ~A ~% ~A " *full-block* *upper-half*)
              (render-frame (%vertical-blinker-box) vp))
    (is-equal (format nil "   ~%   ")
              (render-frame (make-world :topology :box :width 3 :height 3) vp))
    ;; an even height has no half-dead last line; the four characters appear
    (let ((w (make-world :topology :box :width 4 :height 2)))
      (setf (alive-p w 0 0) t (alive-p w 1 1) t (alive-p w 2 0) t (alive-p w 2 1) t)
      (is-equal (format nil "~A~A~A " *upper-half* *lower-half* *full-block*)
                (render-frame w (make-viewport :x 0 :y 0 :width 4 :height 2))))))

(deftest render/viewport-offsets
  (let ((w (make-world)))
    (setf (alive-p w -5 -5) t)
    (is-equal (format nil "...~%.O.~%...")
              (render-frame w (make-viewport :x -6 :y -6 :width 3 :height 3) :style :dots))
    (is-equal (format nil "O..~%...~%...")
              (render-frame w (make-viewport :x -5 :y -5 :width 3 :height 3) :style :dots))
    (is-equal (format nil "...~%...~%..O")
              (render-frame w (make-viewport :x -7 :y -7 :width 3 :height 3) :style :dots))
    (is-equal (format nil "..~%..")
              (render-frame w (make-viewport :x 0 :y 0 :width 2 :height 2) :style :dots))
    ;; following-viewport centers on the bounding box
    (let ((vp (following-viewport w 3 3)))
      (is (viewport-p vp))
      (is-equal 3 (viewport-width vp))
      (is-equal 3 (viewport-height vp))
      (is-equal -6 (viewport-x vp))
      (is-equal -6 (viewport-y vp))
      (is-equal (format nil "...~%.O.~%...") (render-frame w vp :style :dots))))
  (let ((w (make-world)))
    (setf (alive-p w 10 10) t (alive-p w 14 12) t)    ; bounding box 5x3, center (12,11)
    (let ((vp (following-viewport w 5 3)))
      (is-equal 10 (viewport-x vp))
      (is-equal 10 (viewport-y vp))
      (is-equal (format nil "O....~%.....~%....O") (render-frame w vp :style :dots))))
  ;; default-viewport: plane centered on the origin, torus/box clamped to the world
  (let ((vp (default-viewport (make-world) 80 24)))
    (is-equal -40 (viewport-x vp))
    (is-equal -12 (viewport-y vp))
    (is-equal 80 (viewport-width vp))
    (is-equal 24 (viewport-height vp)))
  (let ((vp (default-viewport (make-world) 3 3)))
    (is-equal -1 (viewport-x vp))
    (is-equal -1 (viewport-y vp)))
  (let ((vp (default-viewport (make-world :topology :torus :width 10 :height 5) 80 24)))
    (is-equal 0 (viewport-x vp))
    (is-equal 0 (viewport-y vp))
    (is-equal 10 (viewport-width vp))
    (is-equal 5 (viewport-height vp)))
  (let ((vp (default-viewport (make-world :topology :box :width 10 :height 5) 4 3)))
    (is-equal 0 (viewport-x vp))
    (is-equal 4 (viewport-width vp))
    (is-equal 3 (viewport-height vp)))
  ;; following on a torus is the default; following an empty plane centers on the origin
  (let* ((w (make-world :topology :torus :width 10 :height 5))
         (vp (following-viewport w 80 24)))
    (setf (alive-p w 9 4) t)
    (is-equal 10 (viewport-width vp))
    (is-equal 5 (viewport-height vp))
    (is-equal 0 (viewport-x vp))
    (is-equal 0 (viewport-y (following-viewport w 80 24))))
  (let ((vp (following-viewport (make-world) 3 3)))
    (is-equal -1 (viewport-x vp))
    (is-equal -1 (viewport-y vp)))
  ;; the default viewport of a plane with a cell far away does not show it; following does
  (let ((w (make-world)))
    (setf (alive-p w 100 100) t)
    (is (not (search "O" (render-frame w (default-viewport w 10 10) :style :dots))))
    (is (search "O" (render-frame w (following-viewport w 10 10) :style :dots))))
  (let ((s (princ-to-string (make-viewport :x -6 :y -6 :width 3 :height 3))))
    (is (search "3x3" s))
    (is (search "-6" s))))

(deftest render/frame-rows
  (is-equal 3 (frame-rows :blocks 5))
  (is-equal 5 (frame-rows :ascii 5))
  (is-equal 5 (frame-rows :dots 5))
  (is-equal 2 (frame-rows :blocks 4))
  (is-equal 1 (frame-rows :blocks 1))
  (is-equal 4 (frame-rows :dots 4))
  (is-equal 2 (cells-per-row :blocks))
  (is-equal 1 (cells-per-row :ascii))
  (is-equal 1 (cells-per-row :dots))
  ;; a rendered frame has frame-rows lines
  (let ((w (make-world :topology :box :width 2 :height 5))
        (vp (make-viewport :x 0 :y 0 :width 2 :height 5)))
    (is-equal 3 (length (%split-lines (render-frame w vp :style :blocks))))
    (is-equal 5 (length (%split-lines (render-frame w vp :style :ascii))))
    (is-equal 5 (length (%split-lines (render-frame w vp :style :dots))))))

(deftest render/status-line
  (let ((w (%pattern-world "blinker")))
    (let ((s (status-line w :width 80 :fps 20 :seed 7)))
      (is-equal 80 (length s))
      (is (search "gen 0" s))
      (is (search "pop 3" s))
      (is (search "B3/S23" s))
      (is (search "plane" s))
      (is (search "20 fps" s))
      (is (search "seed 7" s))
      (is (not (search "PAUSED" s)))
      (is (%starts-with-p "gen 0  pop 3  B3/S23  plane  20 fps  seed 7  " s)
          "order and spacing: ~S" s))
    (let ((s (status-line w :width 80 :paused t :fps 20)))
      (is-equal 80 (length s))
      (is (search "PAUSED" s))
      (is (%starts-with-p "PAUSED  gen 0  pop 3" s)))
    (is-equal 10 (length (status-line w :width 10 :fps 20 :seed 7)))
    (is-equal "gen 0  pop" (status-line w :width 10))
    (is-equal "PAUSED  ge" (status-line w :width 10 :paused t))
    (is-equal 200 (length (status-line w :width 200)))
    (is-equal 80 (length (status-line w)))
    (let ((s (status-line w :width 200 :fps 2.5 :follow t)))
      (is (search "2.5 fps" s))
      (is (search "  follow  " s))
      (is (search "space pause  n step  +/- speed  f follow  r reseed  c clear  q quit" s))
      (is (%ends-with-p "q quit" (string-right-trim " " s))))
    (let ((s (status-line w :width 200 :keys nil)))
      (is (not (search "quit" s)))
      (is (not (search "fps" s)))
      (is (not (search "seed" s)))
      (is (not (search "follow" s)))
      (is-equal "gen 0  pop 3  B3/S23  plane" (string-right-trim " " s)))
    (is (search "seed 123456" (status-line w :width 200 :keys nil :seed 123456)))
    (is (search "1000 fps" (status-line w :width 200 :keys nil :fps 1000)))
    (step-world w 12)
    (is (search "gen 12" (status-line w :width 80))))
  (let ((w (make-world :topology :torus :width 80 :height 46 :rule "highlife")))
    (randomize w :seed 1)
    (let ((s (status-line w :width 100 :keys nil)))
      (is (search "torus 80x46" s))
      (is (search "B36/S23" s))
      (is (search (format nil "pop ~D" (population w)) s))))
  (is (search "box 20x20"
              (status-line (make-world :topology :box :width 20 :height 20) :width 100))))

(deftest render/draw
  (let* ((w (make-world))
         (vp (make-viewport :x 0 :y 0 :width 40 :height 3))
         (home (format nil "~C[H" #\Esc)))
    (place w "blinker" :x 0 :y 1)
    (let* ((s (make-string-output-stream))
           (result (draw w vp :style :dots :fps 20 :stream s))
           (out (get-output-stream-string s))
           (frame (render-frame w vp :style :dots))
           (status (status-line w :width 40 :fps 20)))
      (is (null result) "draw returns nil")
      (is (%starts-with-p home out) "starts with ESC[H")
      (is (search frame out) "contains the frame")
      (is (search (format nil "OOO~A" (make-string 37 :initial-element #\.)) out))
      (is (search status out) "contains the status line")
      (is (search "gen 0  pop 3  B3/S23  plane  20 fps" out))
      (is (char/= #\Newline (char out (1- (length out)))) "no trailing newline")
      (is-equal (concatenate 'string home frame (string #\Newline) status) out))
    ;; the default stream is *standard-output*; paused and seed reach the status line
    (multiple-value-bind (value out err)
        (with-captured-output (o e) (draw w vp :style :ascii :paused t :seed 9 :keys nil))
      (is (null value))
      (is (%starts-with-p home out))
      (is (search "###" out))
      ;; the status line is cut at the viewport's 40 columns, so "seed 9" does not fit
      (is (search "PAUSED  gen 0  pop 3  B3/S23  plane  see" out))
      (is (not (search "quit" out)))
      (is-equal "" err))
    ;; the default style is :blocks: three LOWER HALF BLOCKs for row 1 under a dead row 0
    (let ((s (make-string-output-stream)))
      (draw w vp :stream s)
      (is (search (format nil "~A~A~A" *lower-half* *lower-half* *lower-half*)
                  (get-output-stream-string s))))))
