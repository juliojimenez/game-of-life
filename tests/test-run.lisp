;;;; tests/test-run.lisp — tests for src/run.lisp: the stability detector, simulate and run
;;;; (DESIGN.md §5.7).

(in-package :game-of-life-test)

(defun %simulate-result (world &rest keys)
  "SIMULATE WORLD with KEYS; return its two values as a list (outcome period)."
  (multiple-value-bind (outcome period) (apply #'simulate world keys)
    (list outcome period)))

(defun %run-to-string (world &rest keys)
  "RUN WORLD on a string stream without a keyboard, at 1000 fps, in dots, on a fixed 40x12
viewport (any of which KEYS may override). Returns (values outcome period output)."
  (let ((s (make-string-output-stream)))
    (multiple-value-bind (outcome period)
        (apply #'run world
               (append keys
                       (list :stream s :keyboard nil :fps 1000 :style :dots
                             :viewport (make-viewport :x -4 :y -4 :width 40 :height 12))))
      (values outcome period (get-output-stream-string s)))))

(deftest run/simulate-outcomes
  (let ((w (%pattern-world "blinker")))
    (is-equal '(:periodic 2) (%simulate-result w))
    (is-equal 2 (world-generation w))
    (is-equal 3 (population w)))
  (let ((w (%pattern-world "block")))
    (is-equal '(:periodic 1) (%simulate-result w))
    (is-equal 1 (world-generation w)))
  (let ((w (%pattern-world "diehard")))
    (is-equal '(:extinct nil) (%simulate-result w))
    (is-equal 130 (world-generation w))
    (is-equal 0 (population w)))
  (let ((w (%pattern-world "glider")))
    (is-equal '(:limit nil) (%simulate-result w :generations 8))
    (is-equal 8 (world-generation w))
    (is-equal 5 (population w)))
  (let ((w (make-world)))
    (is-equal '(:extinct nil) (%simulate-result w :generations 10))
    (is-equal 0 (world-generation w)))
  (let ((w (make-world)))
    (is-equal '(:extinct nil) (%simulate-result w))
    (is-equal 0 (world-generation w)))
  (signals life-error (simulate (%pattern-world "glider") :generations nil :stop-when-stable nil))
  (signals life-error (simulate (%pattern-world "glider") :stop-when-stable nil))
  ;; the checks run extinction, stability, limit: a blinker with :generations 2 is periodic
  (let ((w (%pattern-world "blinker")))
    (is-equal '(:periodic 2) (%simulate-result w :generations 2))
    (is-equal 2 (world-generation w)))
  (let ((w (%pattern-world "blinker")))
    (is-equal '(:limit nil) (%simulate-result w :generations 1))
    (is-equal 1 (world-generation w)))
  (let ((w (%pattern-world "blinker")))
    (is-equal '(:limit nil) (%simulate-result w :generations 10 :stop-when-stable nil))
    (is-equal 10 (world-generation w)))
  ;; a diehard with a limit before 130 hits the limit; stop-when-stable nil still sees extinction
  (let ((w (%pattern-world "diehard")))
    (is-equal '(:limit nil) (%simulate-result w :generations 100))
    (is-equal 100 (world-generation w)))
  (let ((w (%pattern-world "diehard")))
    (is-equal '(:extinct nil) (%simulate-result w :generations 1000 :stop-when-stable nil))
    (is-equal 130 (world-generation w)))
  ;; generations 0 takes no step
  (let ((w (%pattern-world "glider")))
    (is-equal '(:limit nil) (%simulate-result w :generations 0))
    (is-equal 0 (world-generation w)))
  ;; on-step is called once per step with the world
  (let* ((w (%pattern-world "glider"))
         (calls 0)
         (same t)
         (generations '()))
    (simulate w :generations 8
                :on-step (lambda (world)
                           (incf calls)
                           (push (world-generation world) generations)
                           (unless (eq world w) (setf same nil))))
    (is-equal 8 calls)
    (is same "on-step receives the world")
    (is-equal '(1 2 3 4 5 6 7 8) (reverse generations)))
  (let* ((w (%pattern-world "blinker"))
         (calls 0))
    (simulate w :on-step (lambda (world) (declare (ignore world)) (incf calls)))
    (is-equal 2 calls))
  ;; history is the detector depth: a pentadecathlon (period 15) is missed with history 10
  (let ((w (%pattern-world "pentadecathlon")))
    (is-equal '(:limit nil) (%simulate-result w :generations 40 :history 10))
    (is-equal 40 (world-generation w)))
  (let ((w (%pattern-world "pentadecathlon")))
    (is-equal '(:periodic 15) (%simulate-result w :generations 40 :history 15))
    (is-equal 15 (world-generation w)))
  (let ((w (%pattern-world "pentadecathlon")))
    (is-equal '(:periodic 15) (%simulate-result w :generations 40))
    (is-equal 15 (world-generation w)))
  ;; a glider on an 8x8 torus repeats at 32
  (let ((w (make-world :topology :torus :width 8 :height 8)))
    (place w "glider")
    (is-equal '(:periodic 32) (%simulate-result w :generations 100))
    (is-equal 32 (world-generation w))))

(deftest run/detector
  (let ((d (make-stability-detector)) (w (%pattern-world "blinker")))
    (is (typep d 'stability-detector))
    (is (null (observe d w)))
    (step-world w)
    (is (null (observe d w)))
    (step-world w)
    (is-equal 2 (observe d w))
    (step-world w)
    (is-equal 2 (observe d w)))
  (let ((d (make-stability-detector)) (w (%pattern-world "block")))
    (is (null (observe d w)))
    (step-world w)
    (is-equal 1 (observe d w)))
  (let ((d (make-stability-detector)) (w (%pattern-world "glider")))
    (is (loop repeat 21 never (prog1 (observe d w) (step-world w)))
        "a glider on the plane never repeats within 20 steps"))
  (let ((d (make-stability-detector :depth 2)) (w (%pattern-world "pulsar")))
    (is (loop repeat 10 never (prog1 (observe d w) (step-world w)))
        "period 3 is beyond depth 2"))
  (let ((d (make-stability-detector :depth 3)) (w (%pattern-world "pulsar")))
    (is (null (observe d w)))
    (step-world w)
    (is (null (observe d w)))
    (step-world w)
    (is (null (observe d w)))
    (step-world w)
    (is-equal 3 (observe d w)))
  ;; a period equal to the depth is found (compare before storing)
  (let ((d (make-stability-detector :depth 15)) (w (%pattern-world "pentadecathlon")))
    (is (loop repeat 15 never (prog1 (observe d w) (step-world w))))
    (is-equal 15 (observe d w)))
  (let ((d (make-stability-detector :depth 14)) (w (%pattern-world "pentadecathlon")))
    (is (loop repeat 30 never (prog1 (observe d w) (step-world w))) "period 15 is beyond depth 14"))
  ;; the same cell set in a different world is a repetition; a changed world is not
  (let ((d (make-stability-detector)) (a (%pattern-world "block")) (b (%pattern-world "block")))
    (is (null (observe d a)))
    (is-equal 1 (observe d b))
    (setf (alive-p b 10 10) t)
    (is (null (observe d b)))
    (setf (alive-p b 10 10) nil)
    (is-equal 2 (observe d b)))                   ; the block is now two observations back
  ;; the empty world is a state like any other for the detector
  (let ((d (make-stability-detector)) (w (make-world)))
    (is (null (observe d w)))
    (is-equal 1 (observe d w))))

(deftest run/run-headless-stream
  (let ((w (%pattern-world "glider")))
    (multiple-value-bind (outcome period out)
        (%run-to-string w :alternate-screen nil :generations 3)
      (is-equal :limit outcome)
      (is-equal nil period)
      (is-equal 3 (world-generation w))
      (is (search (format nil "~C[?25l" #\Esc) out) "hides the cursor")
      (is (search (format nil "~C[H" #\Esc) out) "homes the cursor")
      (is (search (format nil "~C[2J" #\Esc) out) "clears the screen")
      (is (search "gen 3" out) "the final frame shows generation 3")
      (is (search "pop 5" out))
      (is (search "1000 fps" out))
      (is (search "gen 0" out) "the initial frame is drawn too")
      (is (%ends-with-p (format nil "~C[?25h" #\Esc) out) "ends by showing the cursor")
      (is (not (search (format nil "~C[?1049h" #\Esc) out)) "no alternate screen")
      (is (not (search (format nil "~C[?1049l" #\Esc) out)))
      (is (search "O" out) "the glider is drawn")
      (is (<= 4 (count (char (format nil "~C" #\Esc) 0) out)) "at least one frame per generation")))
  ;; style and follow are accepted; a torus world works too
  (let ((w (make-world :topology :torus :width 8 :height 8)))
    (place w "glider")
    (multiple-value-bind (outcome period out)
        (%run-to-string w :alternate-screen nil :generations 2 :style :ascii
                          :viewport (default-viewport w 80 24))
      (is-equal :limit outcome)
      (is-equal nil period)
      (is (search "gen 2" out) "the 8-column status line still starts with the generation")
      (is (search "#" out))))
  (let ((w (%pattern-world "glider")))
    (multiple-value-bind (outcome period out)
        (%run-to-string w :alternate-screen nil :generations 1 :follow t :seed 5
                          :viewport (make-viewport :x -4 :y -4 :width 80 :height 12))
      (is-equal :limit outcome)
      (is-equal nil period)
      (is (search "follow" out))
      (is (search "seed 5" out)))))

(deftest run/run-alternate-screen
  (let ((w (%pattern-world "glider")))
    (multiple-value-bind (outcome period out)
        (%run-to-string w :alternate-screen t :generations 3)
      (is-equal :limit outcome)
      (is-equal nil period)
      (is (%starts-with-p (format nil "~C[?1049h" #\Esc) out) "starts with the alternate screen")
      (is (%ends-with-p (format nil "~C[?1049l" #\Esc) out) "ends by leaving it")
      (is (%ends-with-p (format nil "~C[?25h~C[?1049l" #\Esc #\Esc) out)
          "show cursor, then leave the alternate screen")
      (is (search (format nil "~C[?25l" #\Esc) out))
      (is (search "gen 3" out))))
  ;; the default is the alternate screen on
  (let ((w (%pattern-world "block")))
    (multiple-value-bind (outcome period out) (%run-to-string w :generations 1)
      (is-equal :limit outcome)
      (is-equal nil period)
      (is (%starts-with-p (format nil "~C[?1049h" #\Esc) out)))))

(deftest run/run-stop-when-stable
  (let ((w (%pattern-world "blinker")))
    (multiple-value-bind (outcome period out)
        (%run-to-string w :alternate-screen nil :stop-when-stable t)
      (is-equal :periodic outcome)
      (is-equal 2 period)
      (is-equal 2 (world-generation w))
      (is (search "gen 2" out) "the final frame is drawn before returning")))
  (let ((w (%pattern-world "block")))
    (multiple-value-bind (outcome period)
        (%run-to-string w :alternate-screen nil :stop-when-stable t :generations 50)
      (is-equal :periodic outcome)
      (is-equal 1 period)
      (is-equal 1 (world-generation w))))
  (let ((w (%pattern-world "diehard")))
    (multiple-value-bind (outcome period out)
        (%run-to-string w :alternate-screen nil :stop-when-stable t)
      (is-equal :extinct outcome)
      (is-equal nil period)
      (is-equal 130 (world-generation w))
      (is (search "gen 130" out))
      (is (search "pop 0" out))))
  ;; the history depth applies here too
  (let ((w (%pattern-world "pentadecathlon")))
    (multiple-value-bind (outcome period)
        (%run-to-string w :alternate-screen nil :stop-when-stable t :generations 40 :history 10)
      (is-equal :limit outcome)
      (is-equal nil period)
      (is-equal 40 (world-generation w))))
  ;; an empty world is extinct at once
  (let ((w (make-world)))
    (multiple-value-bind (outcome period)
        (%run-to-string w :alternate-screen nil :stop-when-stable t :generations 10)
      (is-equal :extinct outcome)
      (is-equal nil period)
      (is-equal 0 (world-generation w)))))

(deftest run/fps-steps
  (is (vectorp *fps-steps*))
  (is (plusp (length *fps-steps*)))
  (is (every (lambda (x) (and (realp x) (plusp x))) *fps-steps*))
  (is (loop for i from 1 below (length *fps-steps*)
            always (< (aref *fps-steps* (1- i)) (aref *fps-steps* i)))
      "*fps-steps* is strictly ascending")
  (is (find 20 *fps-steps*) "the default 20 fps is a step")
  (is-equal 1 (aref *fps-steps* 0)))
