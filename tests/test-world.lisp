;;;; tests/test-world.lisp — tests for src/world.lisp (DESIGN.md §5.3).

(in-package :game-of-life-test)

(deftest world/make
  (let ((w (make-world)))
    (is (world-p w))
    (is-equal :plane (world-topology w))
    (is-equal nil (world-width w))
    (is-equal nil (world-height w))
    (is-equal 0 (world-generation w))
    (is-equal 0 (population w))
    (is-equal 0 (world-births w))
    (is-equal 0 (world-deaths w))
    (is-equal '() (live-cells w))
    (is (rule-equal *life-rule* (world-rule w)))
    (is-equal "B3/S23" (rule-string (world-rule w))))
  (let ((w (make-world :topology :torus :width 10 :height 5 :rule "highlife")))
    (is-equal :torus (world-topology w))
    (is-equal 10 (world-width w))
    (is-equal 5 (world-height w))
    (is-equal 0 (population w))
    (is-equal "B36/S23" (rule-string (world-rule w))))
  (let ((w (make-world :topology :box :width 4 :height 3 :rule (parse-rule "seeds"))))
    (is-equal :box (world-topology w))
    (is-equal 4 (world-width w))
    (is-equal 3 (world-height w))
    (is-equal "B2/S" (rule-string (world-rule w))))
  (is-equal :plane (world-topology (make-world :topology :plane)))
  (signals life-error (make-world :topology :torus))
  (signals life-error (make-world :topology :torus :width 10))
  (signals life-error (make-world :topology :box :height 10))
  (signals life-error (make-world :topology :box :width 0 :height 5))
  (signals life-error (make-world :topology :torus :width 5 :height -1))
  (signals life-error (make-world :width 10 :height 10))
  (signals life-error (make-world :topology :plane :width 10))
  (signals rule-syntax-error (make-world :rule "B9")))

(deftest world/set-get
  (let ((w (make-world)))
    (is (eq t (setf (alive-p w 0 0) t)) "(setf alive-p) returns its value")
    (setf (alive-p w -3 2) t)
    (setf (alive-p w 5 -1) t)
    (is (eq t (alive-p w 0 0)))
    (is (eq t (alive-p w -3 2)))
    (is (eq t (alive-p w 5 -1)))
    (is (eq nil (alive-p w 1 1)))
    (is (eq nil (alive-p w -1000000 1000000)))
    (is-equal 3 (population w))
    (is-equal '((5 . -1) (0 . 0) (-3 . 2)) (live-cells w))
    (is (eq nil (setf (alive-p w 0 0) nil)) "clearing returns nil")
    (is (eq nil (alive-p w 0 0)))
    (is-equal 2 (population w))
    (is-equal '((5 . -1) (-3 . 2)) (live-cells w))
    ;; setting an alive cell again or clearing a dead one changes nothing
    (setf (alive-p w -3 2) t)
    (setf (alive-p w 7 7) nil)
    (is-equal 2 (population w))
    ;; a generalized boolean sets, and alive-p still answers with T
    (setf (alive-p w 7 7) :on)
    (is (eq t (alive-p w 7 7)))
    (is-equal 3 (population w))
    ;; live-cells is a fresh list
    (is (not (eq (live-cells w) (live-cells w))))
    ;; clear-world keeps the counters, drops the cells, returns the world
    (step-world w)
    (is (eq w (clear-world w)))
    (is-equal 0 (population w))
    (is-equal '() (live-cells w))
    (is-equal 1 (world-generation w))
    (is-equal 0 (world-births w))
    (is-equal 0 (world-deaths w))
    (is-equal :plane (world-topology w))))

(deftest world/torus-wrap
  (let ((w (make-world :topology :torus :width 10 :height 10)))
    (setf (alive-p w -1 -1) t)
    (is (alive-p w 9 9))
    (is (alive-p w -1 -1))
    (is (alive-p w 19 9))
    (is (alive-p w 9 -11))
    (is (alive-p w 109 -1))
    (is-equal '((9 . 9)) (live-cells w))
    (is-equal 1 (population w))
    (setf (alive-p w 10 0) t)            ; wraps to (0,0)
    (is (alive-p w 0 0))
    (is-equal '((0 . 0) (9 . 9)) (live-cells w))
    (setf (alive-p w 19 9) nil)          ; clears (9,9) through the wrap
    (is (not (alive-p w 9 9)))
    (is-equal 1 (population w))
    (is (in-bounds-p w -1 -1))
    (is (in-bounds-p w 100 100))
    (is (in-bounds-p w 0 0))))

(deftest world/box-bounds
  (let ((w (make-world :topology :box :width 5 :height 5)))
    (is (in-bounds-p w 0 0))
    (is (in-bounds-p w 4 4))
    (is (in-bounds-p w 4 0))
    (is (not (in-bounds-p w 5 0)))
    (is (not (in-bounds-p w 0 5)))
    (is (not (in-bounds-p w -1 0)))
    (is (not (in-bounds-p w 0 -1)))
    (is (not (in-bounds-p w 5 5)))
    (setf (alive-p w 5 5) t)
    (setf (alive-p w -1 0) t)
    (setf (alive-p w 0 -1) t)
    (setf (alive-p w 0 5) t)
    (is-equal 0 (population w))
    (is-equal '() (live-cells w))
    (is (not (alive-p w -1 0)))
    (is (not (alive-p w 5 5)))
    (setf (alive-p w 4 4) t)
    (setf (alive-p w 0 0) t)
    (is (alive-p w 4 4))
    (is-equal '((0 . 0) (4 . 4)) (live-cells w)))
  (let ((w (make-world)))
    (is (in-bounds-p w -1000000 1000000))
    (is (in-bounds-p w 0 0))))

(deftest world/neighbor-count
  ;; plane
  (let ((w (make-world)))
    (place w "block" :x 0 :y 0)
    (is-equal 3 (neighbor-count w 0 0))     ; the cell itself does not count
    (is-equal 3 (neighbor-count w 1 1))
    (is-equal 2 (neighbor-count w 2 0))
    (is-equal 2 (neighbor-count w -1 0))
    (is-equal 1 (neighbor-count w 2 2))
    (is-equal 1 (neighbor-count w -1 -1))
    (is-equal 0 (neighbor-count w 5 5))
    (is-equal 0 (neighbor-count w 3 0)))
  ;; torus: the corner of a 5x5 torus sees cells across both seams
  (let ((w (make-world :topology :torus :width 5 :height 5)))
    (setf (alive-p w 4 4) t (alive-p w 0 4) t (alive-p w 4 0) t)
    (is-equal 3 (neighbor-count w 0 0))
    (is-equal 1 (neighbor-count w 1 0))
    (is-equal 1 (neighbor-count w 0 1))
    (is-equal 2 (neighbor-count w 4 4))
    (is-equal 0 (neighbor-count w 2 2))
    (is-equal 3 (neighbor-count w 5 5) )   ; wrapped coordinates work here too
    (is-equal 3 (neighbor-count w -5 0)))
  ;; box: nothing beyond the edges
  (let ((w (make-world :topology :box :width 5 :height 5)))
    (setf (alive-p w 0 0) t (alive-p w 1 0) t (alive-p w 0 1) t (alive-p w 1 1) t)
    (is-equal 3 (neighbor-count w 0 0))
    (is-equal 3 (neighbor-count w 1 1))
    (is-equal 2 (neighbor-count w 2 0))
    (is-equal 1 (neighbor-count w 2 2))
    (is-equal 0 (neighbor-count w 4 4))     ; a torus would see (0,0) here
    (is-equal 0 (neighbor-count w 4 0))))

(deftest world/step-blinker
  (let ((w (make-world)))
    (place w "blinker" :x 0 :y 1)          ; horizontal: (0,1) (1,1) (2,1)
    (is-equal '((0 . 1) (1 . 1) (2 . 1)) (live-cells w))
    (is (eq w (step-world w)) "step-world returns the world")
    (is-equal '((1 . 0) (1 . 1) (1 . 2)) (live-cells w))
    (is-equal 1 (world-generation w))
    (is-equal 2 (world-births w))
    (is-equal 2 (world-deaths w))
    (is-equal 3 (population w))
    (step-world w)
    (is-equal '((0 . 1) (1 . 1) (2 . 1)) (live-cells w))
    (is-equal 2 (world-generation w))
    (is-equal 2 (world-births w))
    (is-equal 2 (world-deaths w))
    (is (eq w (step-world w 2)))
    (is-equal 4 (world-generation w))
    (is-equal '((0 . 1) (1 . 1) (2 . 1)) (live-cells w))
    (step-world w 0)
    (is-equal 4 (world-generation w))
    ;; a lone cell dies: one death, no birth
    (clear-world w)
    (setf (alive-p w 0 0) t)
    (step-world w)
    (is-equal 0 (population w))
    (is-equal 0 (world-births w))
    (is-equal 1 (world-deaths w))
    (is-equal 5 (world-generation w))))

(deftest world/step-block-still
  (let* ((w (%pattern-world "block"))
         (start (copy-world w)))
    (step-world w)
    (is (world-equal start w))
    (is-equal 4 (population w))
    (is-equal 0 (world-births w))
    (is-equal 0 (world-deaths w))
    (is-equal 1 (world-generation w))
    (step-world w 10)
    (is (world-equal start w))
    (is-equal 11 (world-generation w))
    (is-equal '((0 . 0) (1 . 0) (0 . 1) (1 . 1)) (live-cells w))))

(deftest world/glider-plane
  (let ((w (%pattern-world "glider")))
    (is-equal *glider-cells* (live-cells w))
    (multiple-value-bind (dx dy translated-p) (%shift-after-steps w 4)
      (is-equal 1 (abs dx))
      (is-equal 1 (abs dy))
      (is translated-p "the cells after 4 steps are the start cells shifted by (dx,dy)"))
    (multiple-value-bind (dx dy translated-p) (%shift-after-steps w 8)
      (is-equal 2 (abs dx))
      (is-equal 2 (abs dy))
      (is translated-p "after 8 steps the glider has moved two cells"))
    (step-world w 4)
    (is-equal 5 (population w))
    (is-equal 4 (world-generation w))
    (multiple-value-bind (x0 y0 x1 y1) (bounding-box w)
      (is-equal 3 (1+ (- x1 x0)))
      (is-equal 3 (1+ (- y1 y0))))
    ;; every intermediate phase keeps five cells
    (dotimes (i 4)
      (step-world w)
      (is (= 5 (population w)) "five cells at generation ~D" (world-generation w)))
    (is (null (bounding-box (make-world))))))

(deftest world/glider-torus-8
  (let* ((w (make-world :topology :torus :width 8 :height 8))
         (start (progn (place w "glider") (copy-world w))))
    (is-equal 5 (population w))
    (step-world w 4)
    (is (not (world-equal start w)) "not back after 4")
    (step-world w 4)
    (is (not (world-equal start w)) "not back after 8")
    (step-world w 8)
    (is (not (world-equal start w)) "not back after 16")
    (step-world w 16)
    (is (world-equal start w) "back after 32")
    (is-equal 32 (world-generation w))
    (is-equal (world-fingerprint start) (world-fingerprint w))
    (is-equal 5 (population w))))

(deftest world/box-glider-stays-inside
  (let ((w (make-world :topology :box :width 12 :height 12)))
    (place w "glider" :x 1 :y 1)
    (is (loop repeat 100
              always (progn
                       (step-world w)
                       (every (lambda (c) (and (<= 0 (car c) 11) (<= 0 (cdr c) 11)))
                              (live-cells w))))
        "every live cell stays within the 12x12 box")
    (is-equal 100 (world-generation w))
    (is (plusp (population w)) "the glider settles into something inside the box")))

(deftest world/seeds-rule
  (let ((w (make-world :rule "B2/S" :topology :torus :width 20 :height 20)))
    (randomize w :seed 1)
    (is (plusp (population w)))
    (dotimes (i 5)
      (let ((before (live-cells w)))
        (step-world w)
        (is (notany (lambda (c) (alive-p w (car c) (cdr c))) before)
            "no cell survives a Seeds step (step ~D)" (1+ i))
        (is (= (length before) (world-deaths w)) "every live cell died (step ~D)" (1+ i))))))

(deftest world/life-without-death
  (let ((w (make-world :rule "life-without-death" :topology :torus :width 20 :height 20)))
    (randomize w :seed 1)
    (let ((previous (population w)))
      (is (plusp previous))
      (dotimes (i 20)
        (step-world w)
        (is (>= (population w) previous) "population did not drop at step ~D" (1+ i))
        (is (= 0 (world-deaths w)) "no deaths at step ~D" (1+ i))
        (setf previous (population w))))))

(deftest world/randomize
  (let ((a (make-world :topology :torus :width 20 :height 20))
        (b (make-world :topology :torus :width 20 :height 20))
        (c (make-world :topology :torus :width 20 :height 20)))
    (is-equal 42 (randomize a :seed 42))
    (is-equal 42 (randomize b :seed 42))
    (is-equal 43 (randomize c :seed 43))
    (is (world-equal a b) "the same seed gives the same soup")
    (is (not (world-equal a c)) "different seeds differ")
    (is (< 0 (population a) 400) "density 0.3 is neither empty nor full"))
  (let ((w (make-world :topology :torus :width 20 :height 20)))
    (randomize w :density 0 :seed 1)
    (is-equal 0 (population w))
    (randomize w :density 1 :seed 1)
    (is-equal 400 (population w)))
  (let ((w (make-world :topology :box :width 6 :height 4)))
    (randomize w :density 1 :seed 3)
    (is-equal 24 (population w))
    (multiple-value-bind (x0 y0 x1 y1) (bounding-box w)
      (is-equal '(0 0 5 3) (list x0 y0 x1 y1))))
  ;; a clock seed is returned so the soup can be replayed
  (let* ((w (make-world :topology :torus :width 10 :height 10))
         (seed (randomize w)))
    (is (integerp seed))
    (let ((again (make-world :topology :torus :width 10 :height 10)))
      (is-equal seed (randomize again :seed seed))
      (is (world-equal w again) "a clock seed replays")))
  ;; the plane needs the whole rectangle
  (signals life-error (randomize (make-world)))
  (signals life-error (randomize (make-world) :x 0 :y 0 :width 10))
  (signals life-error (randomize (make-world) :width 10 :height 10))
  (let ((w (make-world)))
    (randomize w :x -5 :y -5 :width 10 :height 10 :density 1 :seed 1)
    (is-equal 100 (population w))
    (multiple-value-bind (x0 y0 x1 y1) (bounding-box w)
      (is-equal '(-5 -5 4 4) (list x0 y0 x1 y1))))
  ;; the rectangle is respected and cells outside it are untouched
  (let ((w (make-world :topology :torus :width 20 :height 20)))
    (setf (alive-p w 0 0) t)
    (is-equal 1 (randomize w :x 5 :y 5 :width 5 :height 5 :density 1 :seed 1))
    (is-equal 26 (population w))
    (is (alive-p w 0 0))
    (is (not (alive-p w 4 4)))
    (is (not (alive-p w 10 10)))
    (is (every (lambda (c) (or (equal c '(0 . 0))
                               (and (<= 5 (car c) 9) (<= 5 (cdr c) 9))))
               (live-cells w))))
  ;; randomize does not touch the generation
  (let ((w (make-world :topology :torus :width 10 :height 10)))
    (step-world w 3)
    (randomize w :seed 5)
    (is-equal 3 (world-generation w))))

(deftest world/rng
  (let ((r (make-rng 0)))
    (is (rng-p r))
    (is-equal #xE220A8397B1DCDAF (rng-next r))
    (is-equal #x6E789E6AA1B965F4 (rng-next r)))
  (let ((a (make-rng 1234)) (b (make-rng 1234)))
    (is (loop repeat 100 always (= (rng-next a) (rng-next b)))
        "two (make-rng 1234) streams agree"))
  (let ((a (make-rng 1234)) (b (make-rng 1235)))
    (is (loop repeat 100 thereis (/= (rng-next a) (rng-next b)))
        "seeds 1234 and 1235 differ"))
  (let ((r (make-rng 7)))
    (is (loop repeat 1000
              always (let ((u (rng-unit r)))
                       (and (typep u 'double-float) (<= 0d0 u) (< u 1d0))))
        "rng-unit stays in [0,1)")
    (is (loop repeat 1000
              always (let ((n (rng-next r)))
                       (and (integerp n) (<= 0 n) (< n (expt 2 64)))))
        "rng-next is an unsigned 64-bit integer"))
  (let ((r (make-rng 7)))
    (is (loop repeat 100 never (rng-chance r 0)) "chance 0 never happens")
    (is (loop repeat 100 always (rng-chance r 1)) "chance 1 always happens")
    (is (loop repeat 100 always (member (rng-chance r 0.5) '(t nil))) "rng-chance is boolean"))
  (let ((r (make-rng)))
    (is (rng-p r) "a clock seed works")
    (is (integerp (rng-next r))))
  ;; the seed is masked to 64 bits
  (let ((a (make-rng 0)) (b (make-rng (expt 2 64))))
    (is-equal (rng-next a) (rng-next b))))

(deftest world/copy-equal-fingerprint
  (let* ((w (%pattern-world "glider"))
         (c (progn (step-world w 3) (copy-world w))))
    (is (not (eq w c)))
    (is (world-p c))
    (is (world-equal w c))
    (is (world-equal c w))
    (is-equal (world-fingerprint w) (world-fingerprint c))
    (is-equal 3 (world-generation c))
    (is-equal (world-births w) (world-births c))
    (is-equal (world-deaths w) (world-deaths c))
    (is (rule-equal (world-rule w) (world-rule c)))
    (is-equal (world-topology w) (world-topology c))
    (setf (alive-p c 10 10) t)
    (is (not (world-equal w c)))
    (is (not (world-equal c w)))
    (is (/= (world-fingerprint w) (world-fingerprint c)))
    (is-equal 5 (population w))              ; the original is untouched
    (step-world c)                           ; and so is its generation
    (is-equal 3 (world-generation w))
    (is-equal 4 (world-generation c)))
  ;; the fingerprint does not depend on insertion order
  (let ((a (make-world)) (b (make-world))
        (cells '((3 . 1) (-2 . 5) (7 . 7) (0 . 0) (1 . 1) (-9 . -9))))
    (dolist (c cells) (setf (alive-p a (car c) (cdr c)) t))
    (dolist (c (reverse cells)) (setf (alive-p b (car c) (cdr c)) t))
    (is (world-equal a b))
    (is-equal (world-fingerprint a) (world-fingerprint b))
    (is (typep (world-fingerprint a) '(integer 0)))
    (is (typep (world-fingerprint a) 'fixnum)))
  ;; world-equal ignores rule, topology and generation; a torus copy keeps its size
  (let ((a (%pattern-world "block"))
        (b (%pattern-world "block" :topology :torus :width 8 :height 8 :rule "highlife")))
    (step-world a 5)
    (is (world-equal a b)))
  (let* ((w (make-world :topology :torus :width 8 :height 8)) (c (copy-world w)))
    (is-equal 8 (world-width c))
    (is-equal 8 (world-height c))
    (is-equal :torus (world-topology c))
    (is (world-equal w c))
    (is-equal (world-fingerprint w) (world-fingerprint c))))

(deftest world/place
  (let ((w (make-world)))
    (is (eq w (place w (pattern "glider") :x 0 :y 0)) "place returns the world")
    (is-equal *glider-cells* (live-cells w)))
  (let ((w (make-world)))
    (place w "glider" :x 0 :y 0)
    (is-equal *glider-cells* (live-cells w)))
  (let ((w (make-world)))
    (place w :glider :x 0 :y 0)
    (is-equal *glider-cells* (live-cells w)))
  (let ((w (make-world)))
    (place w "Gosper glider gun" :x 0 :y 0)
    (is-equal 36 (population w)))
  (let ((w (make-world)))
    (place w '((0 . 0) (1 . 0)) :x 5 :y 5)
    (is-equal '((5 . 5) (6 . 5)) (live-cells w)))
  (let ((w (make-world)))
    (place w '((2 . 2) (3 . 3)) :x 0 :y 0)       ; a cell list is used as is
    (is-equal '((2 . 2) (3 . 3)) (live-cells w)))
  (let ((w (make-world)))
    (place w "block" :x 10 :y 20)
    (is-equal '((10 . 20) (11 . 20) (10 . 21) (11 . 21)) (live-cells w)))
  (let ((w (make-world)))
    (place w "block" :x -2 :y -2)
    (is-equal '((-2 . -2) (-1 . -2) (-2 . -1) (-1 . -1)) (live-cells w)))
  ;; centered: torus (floor (- 10 3) 2) = 3; plane (- (floor 3 2)) = -1
  (let ((w (make-world :topology :torus :width 10 :height 10)))
    (place w "glider")
    (multiple-value-bind (x0 y0 x1 y1) (bounding-box w)
      (is-equal '(3 3 5 5) (list x0 y0 x1 y1))))
  (let ((w (make-world :topology :box :width 10 :height 10)))
    (place w "lwss")                           ; 5x4: (floor 5 2) = 2, (floor 6 2) = 3
    (multiple-value-bind (x0 y0 x1 y1) (bounding-box w)
      (is-equal '(2 3 6 6) (list x0 y0 x1 y1))))
  (let ((w (make-world)))
    (place w "glider")
    (multiple-value-bind (x0 y0 x1 y1) (bounding-box w)
      (is-equal '(-1 -1 1 1) (list x0 y0 x1 y1))))
  (let ((w (make-world)))
    (place w "lwss")                           ; plane: (- (floor 5 2)) = -2, (- (floor 4 2)) = -2
    (multiple-value-bind (x0 y0 x1 y1) (bounding-box w)
      (is-equal '(-2 -2 2 1) (list x0 y0 x1 y1))))
  ;; the part outside a box is dropped; a torus wraps
  (let ((w (make-world :topology :box :width 3 :height 3)))
    (place w "block" :x 2 :y 2)
    (is-equal '((2 . 2)) (live-cells w)))
  (let ((w (make-world :topology :torus :width 4 :height 4)))
    (place w "block" :x 3 :y 3)
    (is-equal '((0 . 0) (3 . 0) (0 . 3) (3 . 3)) (live-cells w)))
  ;; placing adds to what is there
  (let ((w (make-world)))
    (place w "block" :x 0 :y 0)
    (place w "block" :x 10 :y 0)
    (is-equal 8 (population w)))
  (signals life-error (place (make-world) "glider" :x 0))
  (signals life-error (place (make-world) "glider" :y 0))
  (signals unknown-pattern-error (place (make-world) "nosuch" :x 0 :y 0)))

(deftest world/print-object
  (let ((s (princ-to-string (%pattern-world "glider"))))
    (is (search "plane" s))
    (is (search "pop" s))
    (is (search "gen" s))
    (is (search "pop 5" s)))
  (let ((s (princ-to-string (make-world :topology :torus :width 80 :height 46))))
    (is (search "torus" s))
    (is (search "80x46" s))
    (is (search "gen 0" s))
    (is (search "pop 0" s)))
  (let ((s (princ-to-string (make-world :topology :box :width 20 :height 10))))
    (is (search "box" s))
    (is (search "20x10" s))))
